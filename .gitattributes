# Teaching resources are fingerprinted byte-for-byte by the application.
src/lic_dsf/illustrative_cases/*.json text eol=lf

# Reviewed Windows bootstrap sources are fingerprinted byte-for-byte.
packaging/windows-bootstrap/*.c text eol=lf
packaging/windows-bootstrap/*.h text eol=lf
packaging/windows-bootstrap/*.ps1 text eol=lf
packaging/windows-bootstrap/*.py text eol=lf

# Windows package helpers ship byte-for-byte in the package; the .cmd files keep CRLF.
packaging/windows-package/*.cmd -text
packaging/windows-package/*.py text eol=lf
